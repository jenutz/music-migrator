# Everything local, machine-specific or obsolete lives in junk/ - one ignored
# folder instead of a rule per artefact. See junk/README.md for what is in it.
junk/

# Local data + secrets (never commit tokens)
data/
secrets/
.env
.env.*
*.db
*.db-wal
*.db-shm
*.key

# Scratch space
TODO

# Python
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual envs
venv/
.venv/

# IDE / OS
.idea/
.vscode/
.DS_Store
.directory

# Logs
*.log

# Static assets we do want to keep
!app/static/*.svg
!app/static/*.ico
